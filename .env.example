# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore / .dockerignore 双重排除 —— 不会进 git，也不会进镜像层。
# 容器通过 compose 的 env_file 注入，明文只存在于本机这一个文件里。

# --- 模型（DeepSeek 官方） ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 注意：模型名以 GET /models 为准（当前：deepseek-flash / deepseek-v4-pro）
#       deepseek-v4flash 不是合法名（会 400）；官方主名 deepseek-flash（v4-flash 是它的别名）

# --- 默认通道（首次启动时写进 <agent>/models.json 与 settings.json） ---
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash

# --- 跑分平台（tsec / TSecBench，可选） ---
# ★ 2026-11-13：这两行优先于 <repo>/.pi/tsecbench.json（tsecbench.py 先读 env 再读文件）。
#   填在这里 = token 只活在本机 .env，不进镜像层，换题换 token 也不用重建镜像。
#   不填时 tsec 回退去读 .pi/tsecbench.json（老行为不变）。
TSEC_BASE_URL=
TSEC_TOKEN=

# --- 本机/WSL 口令（仅交互时用；不要写在这里，见 docs/交付-部署说明.md §密钥） ---
