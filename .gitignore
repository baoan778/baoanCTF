# ── 2026-11-03 新增（git init 前实测体积，单位 MB）────────────────────────
# 判定原则：数据资产 / 可重建产物 / 第三方源码 不入库；我方源码全入库。
# ⚠ gitignore 不支持行尾注释 —— `pocs/  # 说明` 会把「# 说明」当成模式的一部分，
#   于是整条规则失效（本次实测踩过：43315 个文件仍全部被 add）。注释必须独立成行。

# 大体积数据资产（合计 207 MB）
pocs/
kb/
tools/ctfpoc/
tools/wordlists/

# 第三方二进制工具（合计 9 MB，重建靠脚本）
tools/gobin/

# 第三方二进制可执行（rg/fd/jsteg/bkcrack/outguess，共 13 MB）
# install.sh 会重新拉取；源码仓不需要它们
tools/bin/rg
tools/bin/fd
tools/bin/jsteg
tools/bin/bkcrack
tools/bin/outguess

# 抓取的外部 WP 语料（15 MB，wpfetch 可重抓）
tools/knowledge/ctf-wp/

# 第三方源码，只读参考（Q5=B 不改其源码，合计 177 MB）
sapper-v2-master/
vendor/pi/node_modules/
agent-template/npm/node_modules/
# 前端依赖（容器内装，宿主不需要；进了 git 会让 clone 变 300MB+）
work/ui/web/node_modules/

# 本机误建的怪目录（%SystemDrive% 是 Windows 变量没展开留下的空壳）
%SystemDrive%/
.tmp2/

# ── 2026-11-03 追加：work/ 下的运行与测试产物 ─────────────────────────────
# 判定：`work/ui/roles-pack/` 是**配置**；`work/tsecbench-run/radar.py` 与 `slot.sh`
#       是**真脚本**（内存闸门 + 槽位锁，有来历有用法，必须入库）—— 两者都要保住。
#       其余是 fgs/测试跑出来的临时件，每次跑都改时间戳与路径
#       （本次实测：跑一次冒烟就改了 _brief-restart.txt）。
work/_test_cli_smoke/
