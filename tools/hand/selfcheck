  #   IDA/Ghidra 只有 Windows 版，走的是宿主 interop，容器天生够不着 → 不算缺陷。
  if [ -f /.dockerenv ] || [ "${PI_LAB_ROOT:-}" = "/opt/pi-ctf" ]; then
    printf '  %s·%s ida 桥（Windows 侧）在容器内不适用 —— 要逆向上宿主跑 tools/bin/ida%s\n' "$D" "$N" "$N"
  # ★ 2026-11-17：直接 exec 脚本在 Git Bash/MSYS 下**不生效**（#!/bin/bash 不可执行 → rc=126），
  #   而 `bash tools/bin/ida check` 是 rc=0、IDA 也找得到 → 原来一直假报「ida 桥不通」。
  elif timeout 30 bash "$LAB/tools/bin/ida" check >/dev/null 2>&1; then ok "ida 桥通（Windows 侧 IDA 可用）"
  else warn "ida 桥不通（interop/路径）→ 先看 tools/TOOLS.md「Windows 侧逆向」节"; fi
fi


# ── 零依赖静态检查（2026-11-13 新增）────────────────────────────────────────
# 为什么零依赖：本想装 ruff+shellcheck，实测 pip 拉取 10 分钟未完成（网络不稳）。
# 而 CI 里装外部工具本身就是可靠性风险 —— 网络一抖门禁就红得莫名其妙。
# tools/lint_zero.py 只用 Python 自带的 ast，查的是「确定能查出真问题」的几类：
#   语法错误 / 裸 except / except-pass / subprocess 缺 timeout 或缺 encoding。
# 只把 FAIL 计入 FAILS；WARN 只提示，不卡门禁（风格问题不该挡发布）。
if [ -f "$LAB/tools/lint_zero.py" ]; then
  # ★ 只扫**本仓自己的代码**：board/*.py + tools 顶层 *.py。
  #   第一版传了 board tools，rglob 把 tools/venv、tools/vendor（1.7 万个第三方文件）
  #   全扫了 → 1751 个 FAIL 全是别人的代码，噪声把真问题埋掉。
  _lz_files=$(cd "$LAB" && ls board/*.py tools/*.py 2>/dev/null)
  # ★ 2026-11-13：优先用 ruff（AST 级，比手写正则准得多）——
  #   实测 venv 里本来就有 ruff 0.17.5，之前查错位置（查的是宿主坏 venv）以为没有。
  #   ruff 治「未定义名/未使用 import/语法级错误」这类确定性问题；
  #   lint_zero 留作兜底（ruff 不在时仍能查 timeout/encoding 这类 ruff 不管的）。
  # ★ 2026-11-17：venv 是 **WSL 里建的 Linux venv**（pyvenv.cfg home=/home/breakingbad/...），
  #   在 Windows 侧 tools/venv/bin/python 是断链 → 原来永远判「ruff 不可用」。
  #   改为「venv 能跑就用 venv，否则用 PATH 上的 ruff」（宿主 anaconda3/Scripts/ruff.exe 实测 0.15.1）。
  _rf_bin=""
  if [ -x "$LAB/tools/venv/bin/python" ] && "$LAB/tools/venv/bin/python" -m ruff --version >/dev/null 2>&1; then
    _rf_bin="$LAB/tools/venv/bin/python -m ruff"
  elif command -v ruff >/dev/null 2>&1 && ruff --version >/dev/null 2>&1; then
    _rf_bin="ruff"
  fi
  if [ -n "$_rf_bin" ]; then
    # 只选**致命**级别：E9(语法) F63/F7/F82(未定义名/占位符错) —— 风格类一律不选，
    # 避免"为过检而改风格"（那不是修 bug，是制造 churn）。
    # ★ 2026-11-19 加 --no-cache：实测容器里 .ruff_cache/0.17.5 是 root 建的（drwxr-xr-x root root），
    #   降到 ctf 后 ruff 写临时文件 Permission denied → 判「ruff 发现致命问题」，
    #   而**代码其实一行没错**（--no-cache 实跑 All checks passed）。自检结果必须是确定性的，
    #   不值得为一个纯加速缓存把绿的说成红的 —— 直接不落盘。
    _rf=$(cd "$LAB" && timeout 240 $_rf_bin check $_lz_files \
          --select E9,F63,F7,F82 --output-format concise --no-cache 2>&1 | tail -5)
    if echo "$_rf" | grep -q 'All checks passed'; then
      ok "ruff 致命级检查通过（E9/F63/F7/F82）"
    else
      bad "ruff 发现致命问题：$(echo "$_rf" | head -3 | tr '\n' ' ')"
    fi
  else
    warn "ruff 不可用 —— 退回 lint_zero（覆盖范围较窄）"
  fi
  _lz_out=$(cd "$LAB" && timeout 240 python3 tools/lint_zero.py $_lz_files 2>&1 | tail -3)
  _lz_rc=$?
  if [ "$_lz_rc" -eq 124 ]; then
    warn "lint_zero 超时（240s）—— 慢盘/大目录，跳过"
  elif echo "$_lz_out" | grep -q '^FAIL'; then
    bad "lint_zero 发现硬问题：$(echo "$_lz_out" | grep '^FAIL' | head -3 | tr '\n' ' ')"
  else
    ok "lint_zero 通过（$(echo "$_lz_out" | tail -1)）"
  fi
fi
# ── shell 脚本：语法 + set -u 未定义变量（ruff 只管 Python）───────────────
# ★ 2026-11-18 事故：docker/provision-agent.sh 引用 $ROOT 却从未定义它，配上
#   set -euo pipefail → 容器每次启动都死在 provision 阶段、无限重启（Restarting(1)）。
#   ruff 不扫 shell，本机也没有 shellcheck（pip 拉不动），所以自写零依赖检查器：
#   ① bash -n 语法 ② set -u 下引用了**全文件从未赋值**的 $NAME —— 正是那次事故的形态。
#   实测误报为 0：141 个脚本全绿；把修复前的 provision-agent.sh 喂进去，它精确指出 L163 $ROOT。
if [ -f "$LAB/tools/lint_sh.py" ]; then
  _sh_out=$(cd "$LAB" && timeout 240 python3 tools/lint_sh.py 2>&1)
  _sh_rc=$?
  if [ "$_sh_rc" -eq 124 ]; then
    warn "shell 体检超时（240s）—— 慢盘，跳过"
  elif echo "$_sh_out" | grep -q '^FAIL'; then
    bad "shell 体检发现硬问题（未定义变量/语法）：$(echo "$_sh_out" | grep '^FAIL' | head -3 | tr '\n' ' ')"
  elif [ "$_sh_rc" -ne 0 ]; then
    warn "shell 体检异常退出 rc=$_sh_rc：$(echo "$_sh_out" | tail -2 | tr '\n' ' ')"
  else
    ok "shell 体检通过（$(echo "$_sh_out" | tail -1)）"
  fi
fi
# ── 结论自检台账（verify_claim）──────────────────────────────────────────
# 交付「发现缺陷 / 根因锁定」类结论前应登记证据等级；这里只报状态，不卡门禁
# （因为它依赖人主动登记，卡门禁会迫使为了过检而登记假数据）。
if [ -x "$LAB/tools/verify_claim.py" ]; then
  # grep -c 空表时自己就打印 0（并返回 1）——旧写法再 "|| echo 0" 会拼成 "0\n0"，
  # 于是下面 [ -gt 0 ] 报 "integer expected"，每次 selfcheck 都刷一条假告警。
  _vc_n=$(python3 "$LAB/tools/verify_claim.py" --list 2>/dev/null | grep -c '\[' || true)
  _vc_n=${_vc_n:-0}
  if [ "$_vc_n" -gt 0 ]; then
    ok "结论台账：已登记 $_vc_n 条（verify_claim --list 可查）"
  else
    printf '  %s·%s 结论台账为空 —— 报缺陷前建议跑 tools/verify_claim.py 登记证据等级%s\n' "$D" "$N" "$N"
  fi
fi
# ── 结论 ─────────────────────────────────────────────────────────────────────
echo
if [ "$FAIL" -eq 0 ] && [ "$WARN" -eq 0 ]; then
  printf '%s结论: ✓ 全部通过%s\n' "$G$B" "$N"
elif [ "$FAIL" -eq 0 ]; then
  printf '%s结论: ⚠ 通过（%d 条警告）%s\n' "$Y$B" "$WARN" "$N"
else
  printf '%s结论: ✗ %d 项失败 / %d 项警告%s\n' "$R$B" "$FAIL" "$WARN" "$N"
fi
exit $((FAIL > 0 ? 1 : 0))
