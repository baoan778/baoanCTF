#!/bin/bash
# pggdb —— 带 gef 增强的 gdb（pwn 本地调试用）
#   pggdb ./chal
# 为什么不是 pwndbg：pwndbg 无 PyPI 包且 ghproxy 404；gef 是单文件，不污染 ~/.gdbinit
SELF="$0"; . "$(cd "$(dirname "$0")/../libexec" && pwd)/labenv.sh"
GEF="$T/gobin/gef.py"
[ -f "$GEF" ] || lab_die "找不到 gef.py（$GEF）"
command -v gdb >/dev/null 2>&1 || lab_die "系统里没有 gdb"
exec gdb -q -x "$GEF" "$@"
