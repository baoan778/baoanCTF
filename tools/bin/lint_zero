#!/bin/bash
# lint_zero：零依赖静态检查（语法/裸except/缺timeout/缺encoding）
SELF="$0"; . "$(cd "$(dirname "$0")/../libexec" && pwd)/labenv.sh"
# ★ 2026-11-17 修：原来写 exec "$ROOT/tools/lint_zero.py" —— MSYS 下 bash 会把这个 .py
#   当成 shell 脚本直接跑（报 `import: command not found`、`syntax error near ...`），
#   于是这个入口一直是坏的，而调用方多半直接 python3 tools/xxx.py，所以没人发现。
#   与 llmrec / wpfetch / skilllint 等统一：显式用 labenv 解析出的 $PY 启动。
exec "$PY" "$T/lint_zero.py" "$@"
