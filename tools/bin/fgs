#!/bin/sh
# pi-lab 黑板 CLI —— 包装 <仓库根>/board/fgs.py，让技能/子代理里直接敲 `fgs`
#
# 契约见 <仓库根>/board/schema.md；实现见 <仓库根>/board/fgs.py。
#
# ★ 路径自解析（2026-10-12，适配发布包 / exe / 换目录）：
#   原来写死 `exec python3 <仓库根>/board/fgs.py` —— 仓库一搬家、
#   或者被打进 exe 分发包（exe 侧目录名与 WSL 路径完全不同），命令就找不到实现，
#   而且报的是「python3: can't open file」这种看不清根因的错。
#   现在从**脚本自身位置**推仓库根（tools/bin 与 tools/hand 都是两级深）。
#
# 解释器也不写死：python3 → python → py 依次找；可用 PI_LAB_PYTHON=<路径> 覆盖
#（Windows 侧常见只有 python.exe，没有 python3）。

self=$0
case "$self" in
  */*) : ;;
  *) self=$(command -v -- "$self" 2>/dev/null || echo "$self") ;;
esac

# 跟软链：tools/bin/fgs → tools/hand/fgs（make-bin.sh 用软链挂出去，只留一份正本）
_i=0
while [ -L "$self" ] && [ "$_i" -lt 10 ]; do
  _link=$(readlink "$self")
  case "$_link" in
    /*) self=$_link ;;
    *)  self=$(dirname "$self")/$_link ;;
  esac
  _i=$((_i + 1))
done

HERE=$(cd "$(dirname "$self")" && pwd)
ROOT=$(cd "$HERE/../.." && pwd)          # tools/hand 或 tools/bin → 仓库根

PY=${PI_LAB_PYTHON:-}
# 2026-11-19: 能找得到 != 能跑。PATH 里的 python3 可能是个坏解释器
# (实测: anaconda3\python.exe 缺 Lib/encodings)，判据必须是跑得起来。
if [ -n "$PY" ] && ! "$PY" -c "pass" >/dev/null 2>&1; then PY=""; fi
if [ -z "$PY" ]; then
  for _c in python3 python py; do
    _p=$(command -v "$_c" 2>/dev/null) || continue
    [ -n "$_p" ] || continue
    if "$_p" -c "pass" >/dev/null 2>&1; then PY=$_p; break; fi
  done
fi
# 本仓 Windows 原生 venv 兜底 (Python 3.12 + pwn/z3)
if [ -z "$PY" ] && [ -x "$ROOT/tools/venv-win/Scripts/python.exe" ]; then
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
      if "$ROOT/tools/venv-win/Scripts/python.exe" -c "pass" >/dev/null 2>&1; then
        PY="$ROOT/tools/venv-win/Scripts/python.exe"
      fi
      ;;
  esac
fi
if [ -z "$PY" ]; then
  echo "fgs: 找不到 python3/python —— 用 PI_LAB_PYTHON=<解释器路径> 指定" >&2
  exit 127
fi
if [ ! -f "$ROOT/board/fgs.py" ]; then
  echo "fgs: 在 $ROOT/board/ 下找不到 fgs.py（发布包里 board/ 是不是没带上？）" >&2
  exit 127
fi

exec "$PY" "$ROOT/board/fgs.py" "$@"
